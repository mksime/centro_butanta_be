# Ambiente: development | staging | production | test
# Em production: /docs e /openapi.json ficam desabilitados e SECRET_KEY é
# obrigatória (sem o valor padrão).
ENVIRONMENT=development

# Conexão com o banco
# DATABASE_URL tem precedência sobre as variáveis POSTGRES_* abaixo.
# Em produção (Render, Cloud Run) normalmente só ela é definida.
# DATABASE_URL=postgresql://usuario:senha@host:5432/centro_butanta
POSTGRES_USER=cbbe
POSTGRES_PASSWORD=cbbe_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=centro_butanta

# CORS — origens permitidas separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth
SECRET_KEY=mude-em-producao-chave-secreta-min-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate limit (por IP). Use redis://host:porta ao rodar várias instâncias.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5/minute
RATE_LIMIT_STORAGE_URI=memory://

# Observabilidade (opcional). Sem SENTRY_DSN, o Sentry fica desativado.
# SENTRY_DSN=https://chave@o000000.ingest.sentry.io/0000000
SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=centro-butanta-api@1.0.0

# Seed do primeiro administrador (ativa apenas no primeiro deploy/desenvolvimento)
ADMIN_SEED_ENABLED=false
ADMIN_SEED_EMAIL=admin@centrobutanta.com
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_CARGO=Coordenador
ADMIN_SEED_SETOR=Administrativo
